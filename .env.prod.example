# Production. Скопируйте на сервере в /opt/oi-bas/.env.
# Этот файл — шаблон: все значения REPLACE_* необходимо заменить.

POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_DB=ekipazh
POSTGRES_USER=ekipazh
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

# Публичный адрес приложения и данные для автоматического TLS-сертификата Let's Encrypt.
APP_DOMAIN=oi-bas.space
TLS_EMAIL=REPLACE_WITH_ADMIN_EMAIL
APP_BASE_URL_PROD=https://oi-bas.space

# Образы, которые будет публиковать CI/CD. Для первого локального production-теста
# можно временно указать oi-bas-api:local и oi-bas-web:local.
API_IMAGE=ghcr.io/birdfromskyy/oi-bas-api:main
WEB_IMAGE=ghcr.io/birdfromskyy/oi-bas-web:main

WEB_HTTP_PORT=80
WEB_HTTPS_PORT=443
DATABASE_MAX_CONNS=10
