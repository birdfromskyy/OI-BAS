# Локальная разработка. Не используйте этот файл на production-сервере.
# Скопируйте его в .env и замените пароль.
POSTGRES_DB=ekipazh
POSTGRES_USER=ekipazh
POSTGRES_PASSWORD=change-me-for-production

# Vite PWA, API и PostgreSQL будут доступны с хоста.
POSTGRES_PORT=5435
API_PORT=8081
WEB_PORT_DEV=8080
APP_BASE_URL_DEV=http://localhost:8080
