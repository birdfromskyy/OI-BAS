# PostgreSQL. Use a unique, strong password outside local development.
POSTGRES_DB=ekipazh
POSTGRES_USER=ekipazh
POSTGRES_PASSWORD=change-me-for-production

# Development: Vite PWA, API and PostgreSQL are available on the host.
POSTGRES_PORT=5435
API_PORT=8081
WEB_PORT_DEV=8080
APP_BASE_URL_DEV=http://localhost:8080

# Production: Caddy serves the PWA and reverse-proxies /api to Go.
WEB_PORT_PROD=8080
APP_BASE_URL_PROD=http://localhost:8080
